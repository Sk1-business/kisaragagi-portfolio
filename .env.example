# 本番・ステージングの API オリジン。
# ローカル開発では未設定推奨（Vite が /api を 127.0.0.1:8000 にプロキシ）。直指定する場合は localhost ではなく http://127.0.0.1:8000 を推奨（Windows の IPv6 解決で失敗しやすいため）。
# false にすると実APIへ接続する。未設定または true ではブラウザ内の美容室デモ。
# VITE_DEMO_MODE=false
# GitHub Pages 用。ローカルは未設定（/）。
# VITE_BASE_PATH=/kisaragagi-portfolio/

VITE_API_BASE_URL=https://api.example.com
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# 予約者ポータル: 無操作でログアウトするまでの時間（ミリ秒）。未設定時は 30 分。
# VITE_CUSTOMER_IDLE_TIMEOUT_MS=1800000
